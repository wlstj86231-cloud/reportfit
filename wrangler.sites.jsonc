{
  // Apex static worker for reportools.com. Do not use wrangler.jsonc (OpenNext) for this host.
  "name": "reportools",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-07-18",
  // Serve only on the apex route; a *.workers.dev copy would duplicate the site.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "reportools.com/*", "zone_name": "reportools.com" }
  ]
}
